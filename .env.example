EXCHANGE_ID=kraken
SYMBOL=BTC/USD
TIMEFRAME=1h
MODE=paper
STARTING_BALANCE=10000
POLL_INTERVAL_SECONDS=60

# Taker fee as a fraction (0.004 = 0.4%). Leave empty to use the exchange default
# in tradingbot/config.py. Set it to your actual fee tier.
TAKER_FEE_PCT=

# Only needed for live trading. Never commit real keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Must be exactly "yes" to unlock live trading, in addition to API keys above.
I_UNDERSTAND_LIVE_TRADING_RISK=
