# Optional: everything below has sensible defaults. You only need this file
# (copied to .env) for sandbox/live trading keys or to change settings.
EXCHANGE_ID=alpaca
SYMBOL=BTC/USD
TIMEFRAME=1h
# paper = local simulation, sandbox = exchange paper account (e.g. Alpaca paper), live = real money
MODE=paper
STARTING_BALANCE=10000
HISTORY_BARS=5000
# Fee per fill used in backtests (Alpaca crypto lowest tier is 0.25%)
TAKER_FEE_PCT=0.0025
POLL_INTERVAL_SECONDS=60

# Only needed for MODE=sandbox (your Alpaca *paper* keys) or MODE=live. Never commit real keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Must be exactly "yes" to unlock live trading, in addition to API keys above.
I_UNDERSTAND_LIVE_TRADING_RISK=
