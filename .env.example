EXCHANGE_ID=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h
# paper = local simulation, sandbox = exchange paper account (e.g. Alpaca paper), live = real money
MODE=paper
STARTING_BALANCE=10000
POLL_INTERVAL_SECONDS=60

# Needed for sandbox and live modes. Never commit real keys.
# For Alpaca paper: EXCHANGE_ID=alpaca, SYMBOL=BTC/USD, MODE=sandbox, and your *paper* account keys.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Must be exactly "yes" to unlock live trading, in addition to API keys above.
I_UNDERSTAND_LIVE_TRADING_RISK=
